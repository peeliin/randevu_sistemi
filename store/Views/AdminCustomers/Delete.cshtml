@model store.Models.Customer
@{
    ViewData["Title"] = "Müşteri Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-trash"></i> Müşteri Sil</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Geri Dön
    </a>
</div>

<div class="card">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">Uyarı</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <span>Bu müşteriyi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</span>
            @if (Model.Appointments != null && Model.Appointments.Any())
            {
                <br />
                <strong>Dikkat:</strong>
                <span>Bu müşterinin @(Model.Appointments.Count) adet randevusu bulunmaktadır.</span>
            }
        </div>
        
        <dl class="row">
            <dt class="col-sm-4">Ad Soyad:</dt>
            <dd class="col-sm-8">@Model.FullName</dd>
            
            <dt class="col-sm-4">Telefon:</dt>
            <dd class="col-sm-8">@Model.Phone</dd>
            
            <dt class="col-sm-4">E-posta:</dt>
            <dd class="col-sm-8">@(Model.Email ?? "-")</dd>
            
            <dt class="col-sm-4">Randevu Sayısı:</dt>
            <dd class="col-sm-8">
                <span class="badge bg-info">@(Model.Appointments?.Count ?? 0)</span>
            </dd>
        </dl>
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Evet, Sil
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> İptal
                </a>
            </div>
        </form>
    </div>
</div>

