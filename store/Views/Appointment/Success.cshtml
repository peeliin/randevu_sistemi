@model store.Models.Appointment
@{
    ViewData["Title"] = "Randevu Başarılı";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow text-center">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                    </div>
                    <h2 class="mb-3">Randevunuz Başarıyla Oluşturuldu!</h2>
                    <p class="text-muted mb-4">En kısa sürede sizinle iletişime geçeceğiz.</p>
                    
                    <div class="card bg-light mb-4">
                        <div class="card-body text-start">
                            <h5 class="mb-3">Randevu Detayları</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Müşteri:</dt>
                                <dd class="col-sm-8">@Model.Customer?.FullName</dd>
                                
                                <dt class="col-sm-4">Telefon:</dt>
                                <dd class="col-sm-8">@Model.Customer?.Phone</dd>
                                
                                <dt class="col-sm-4">Servis:</dt>
                                <dd class="col-sm-8">@Model.Service?.Name</dd>
                                
                                <dt class="col-sm-4">Fiyat:</dt>
                                <dd class="col-sm-8">@Model.Service?.Price.ToString("C")</dd>
                                
                                <dt class="col-sm-4">Personel:</dt>
                                <dd class="col-sm-8">@(Model.Staff?.FullName ?? "Atanacak")</dd>
                                
                                <dt class="col-sm-4">Tarih/Saat:</dt>
                                <dd class="col-sm-8">@Model.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</dd>
                                
                                <dt class="col-sm-4">Durum:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-warning">Beklemede</span>
                                </dd>
                            </dl>
                        </div>
                    </div>
                    
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house"></i> Ana Sayfaya Dön
                        </a>
                        <a asp-controller="Appointment" asp-action="Create" class="btn btn-outline-primary">
                            <i class="bi bi-calendar-plus"></i> Yeni Randevu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

