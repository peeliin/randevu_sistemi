<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Paneli - Güzellik Merkezi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h4><i class="bi bi-scissors"></i> Güzellik Merkezi</h4>
            <p>Admin Yönetim Paneli</p>
        </div>
        <ul class="sidebar-menu">
            <li>
                <a asp-controller="Admin" asp-action="Dashboard" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>
            <li>
                <a asp-controller="AdminAppointments" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminAppointments" ? "active" : "")">
                    <i class="bi bi-calendar-check"></i> Randevular
                </a>
            </li>
            <li>
                <a asp-controller="AdminCustomers" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminCustomers" ? "active" : "")">
                    <i class="bi bi-people"></i> Müşteriler
                </a>
            </li>
            <li>
                <a asp-controller="AdminServices" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminServices" ? "active" : "")">
                    <i class="bi bi-bag"></i> Servisler
                </a>
            </li>
            <li>
                <a asp-controller="AdminStaff" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminStaff" ? "active" : "")">
                    <i class="bi bi-person-badge"></i> Personel
                </a>
            </li>
            <li>
                <a asp-controller="Admin" asp-action="Logout">
                    <i class="bi bi-box-arrow-right"></i> Çıkış Yap
                </a>
            </li>
        </ul>
    </div>
    
    <div class="main-content">
        <div class="top-bar">
            <h5 class="mb-0">@ViewData["Title"]</h5>
            <div class="user-info">
                <span><i class="bi bi-person-circle"></i> Admin</span>
                <a asp-controller="Admin" asp-action="Logout" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-box-arrow-right"></i> Çıkış
                </a>
            </div>
        </div>
        
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @RenderBody()
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

