@model store.Models.Appointment
@{
    ViewData["Title"] = "Randevu Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-trash"></i> Randevu Sil</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Geri Dön
    </a>
</div>

<div class="card">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">Uyarı</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> Bu randevuyu silmek istediğinize emin misiniz? Bu işlem geri alınamaz.
        </div>
        
        <dl class="row">
            <dt class="col-sm-4">Müşteri:</dt>
            <dd class="col-sm-8">@Model.Customer?.FullName</dd>
            
            <dt class="col-sm-4">Servis:</dt>
            <dd class="col-sm-8">@Model.Service?.Name</dd>
            
            <dt class="col-sm-4">Tarih:</dt>
            <dd class="col-sm-8">@Model.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</dd>
            
            <dt class="col-sm-4">Durum:</dt>
            <dd class="col-sm-8">
                <span class="badge bg-@(Model.Status == store.Models.AppointmentStatus.Pending ? "warning" : 
                                          Model.Status == store.Models.AppointmentStatus.Confirmed ? "info" : 
                                          Model.Status == store.Models.AppointmentStatus.Completed ? "success" : "danger")">
                    @Model.Status
                </span>
            </dd>
        </dl>
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Evet, Sil
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> İptal
                </a>
            </div>
        </form>
    </div>
</div>

