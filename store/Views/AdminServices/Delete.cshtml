@model store.Models.Service
@{
    ViewData["Title"] = "Servis Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-trash"></i> Servis Sil</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Geri Dön
    </a>
</div>

<div class="card">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">Uyarı</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> Bu servisi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.
        </div>
        
        <dl class="row">
            <dt class="col-sm-4">Servis Adı:</dt>
            <dd class="col-sm-8">@Model.Name</dd>
            
            <dt class="col-sm-4">Açıklama:</dt>
            <dd class="col-sm-8">@(Model.Description ?? "-")</dd>
            
            <dt class="col-sm-4">Fiyat:</dt>
            <dd class="col-sm-8">@Model.Price.ToString("C")</dd>
            
            <dt class="col-sm-4">Süre:</dt>
            <dd class="col-sm-8">@Model.Duration dakika</dd>
            
            <dt class="col-sm-4">Durum:</dt>
            <dd class="col-sm-8">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Aktif</span>
                }
                else
                {
                    <span class="badge bg-secondary">Pasif</span>
                }
            </dd>
        </dl>
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Evet, Sil
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> İptal
                </a>
            </div>
        </form>
    </div>
</div>

